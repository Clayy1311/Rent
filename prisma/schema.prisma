// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING_PAYMENT
  WAITING_CONFIRMATION
  EXPIRED
  CONFIRMED
  RENTED
  FINISHED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  EXPIRED
  VERIFIED
  REJECTED
}

// --- MODELS ---

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
address String @default("")
  phone   String @default("")
  isVerified Boolean @default(false)
  role      Role      @default(USER)
  bookings  Booking[]
  createdAt DateTime  @default(now())
   emailVerifications EmailVerification[]

}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  items Item[]
  isDeleted Boolean @default(false)
}

model Item {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Int
  stock         Int
  image         String?
  categoryId    Int?
  category      Category?      @relation(fields: [categoryId], references: [id])
  bookingItems  BookingItem[]
  package_items PackageItem[]
  isDeleted    Boolean        @default(false)

}

model Package {
  id             Int           @id @default(autoincrement())
  package_name   String
  description    String?
  min_capacity   Int
  max_capacity   Int
  discount_price Int
  package_items  PackageItem[]
  bookingItems   BookingItem[]
  isDeleted Boolean @default(false)
}

model PackageItem {
  id         Int     @id @default(autoincrement())
  package_id Int
  package    Package @relation(fields: [package_id], references: [id], onDelete: Cascade)
  item_id    Int
  item       Item    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  quantity   Int

  @@index([package_id])
  @@index([item_id])
}

model Booking {
  id                Int           @id @default(autoincrement())
  bookingCode       String?       @unique
  userId            Int
  startDate         DateTime
  endDate           DateTime
  totalPrice        Int
  status            BookingStatus @default(PENDING_PAYMENT)
  createdAt         DateTime      @default(now())
  expiredAt         DateTime?
  
  // Field tambahan untuk operasional admin (Opsi 1)
  actualReturnDate  DateTime?     // Tanggal asli barang dikembalikan
  penaltyAmount     Int?          @default(0)
  adminNote         String?       // Catatan kondisi barang

  user              User          @relation(fields: [userId], references: [id])
  items             BookingItem[]
  payment           Payment?
   offlineCustomerId   Int?
  offlineCustomer     OfflineCustomer? @relation(fields: [offlineCustomerId], references: [id])
}

model BookingItem {
  id        Int      @id @default(autoincrement())
  bookingId Int
  itemId    Int
  packageId Int?
  quantity  Int
  price     Int      // Harga saat dibooking (fixed price)

  booking   Booking  @relation(fields: [bookingId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  package   Package? @relation(fields: [packageId], references: [id])
}

model Payment {
  id           Int           @id @default(autoincrement())
  bookingId    Int           @unique
  amount       Int
  paymentProof String
  status       PaymentStatus @default(PENDING)
  booking      Booking       @relation(fields: [bookingId], references: [id])
}
model OfflineCustomer {
  id          Int      @id @default(autoincrement())
  name        String
  phoneNumber String
  bookings    Booking[]
}

